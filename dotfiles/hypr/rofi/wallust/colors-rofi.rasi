 /* wallust template - colors-rofi */

* {
active-background: #6C7378;
active-foreground: #D5D6D6;
normal-background: #111112;
normal-foreground: #D5D6D6;
urgent-background: #73797B;
urgent-foreground: #D5D6D6;

alternate-active-background: #161B1E;
alternate-active-foreground: #D5D6D6;
alternate-normal-background: #111112;
alternate-normal-foreground: #D5D6D6;
alternate-urgent-background: #111112;
alternate-urgent-foreground: #D5D6D6;

selected-active-background: #73797B;
selected-active-foreground: #D5D6D6;
selected-normal-background: #73797B;
selected-normal-foreground: #D5D6D6;
selected-urgent-background: #73797B;
selected-urgent-foreground: #D5D6D6;

background-color: #111112;
background: rgba(0,0,0,0.7);
foreground: #D5D6D6;
border-color: #6C7378;

color0: #39393A;
color1: #0A0D11;
color2: #0B0E11;
color3: #101416;
color4: #51565A;
color5: #565B5D;
color6: #656667;
color7: #BABBBC;
color8: #828384;
color9: #0E1216;
color10: #0E1217;
color11: #161B1E;
color12: #6C7378;
color13: #73797B;
color14: #87898A;
color15: #BABBBC;


}

