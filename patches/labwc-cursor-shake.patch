+/*
+ * Cursor shake: while the pointer is shaken, the cursor image is scaled up
+ * smoothly and shrinks back once the shaking stops.
+ *
+ * The enlarged image is made from the biggest bitmap of the cursor theme
+ * (seat->shake.source, loaded once) and scaled with cairo, so the theme does
+ * not need to provide bitmaps of every size. A timer drives the animation.
+ */
+#define SHAKE_HOLD_MSEC 400
+#define SHAKE_GROW_MSEC 300
+#define SHAKE_SHRINK_MSEC 400
+#define SHAKE_TICK_MSEC 16
+/* Upper limit of the scale to keep the cursor image at a sane size */
+#define SHAKE_MAX_SCALE_LIMIT 20.0f
+
+static int64_t
+shake_now_msec(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (int64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+static float
+shake_max_scale(void)
+{
+	return fminf(fmaxf(rc.cursor_shake_max_scale, 1.0f),
+		SHAKE_MAX_SCALE_LIMIT);
+}
+
+/* Name of the cursor shape currently shown, or NULL if drawn by a client */
+static const char *
+shake_current_name(struct seat *seat)
+{
+	return seat->server_cursor == LAB_CURSOR_CLIENT
+		? seat->client_cursor_shape : cursor_names[seat->server_cursor];
+}
+
+/* Show the cursor at the current shake scale */
+static void
+shake_apply(struct seat *seat)
+{
+	if (!seat->cursor_visible) {
+		return;
+	}
+	const char *name = shake_current_name(seat);
+	if (!name) {
+		/* The client draws its own cursor image, nothing to scale */
+		return;
+	}
+
+	if (seat->shake.scale <= 1.0f) {
+		if (seat->shake.applied_name) {
+			/* Back to the normal cursor image */
+			seat->shake.applied_name = NULL;
+			seat->shake.applied_width = 0;
+			seat->shake.applied_height = 0;
+			wlr_cursor_unset_image(seat->cursor);
+			wlr_cursor_set_xcursor(seat->cursor,
+				seat->xcursor_manager, name);
+		}
+		return;
+	}
+
+	if (!seat->shake.source) {
+		return;
+	}
+	struct wlr_xcursor *base =
+		wlr_xcursor_manager_get_xcursor(seat->xcursor_manager, name, 1);
+	struct wlr_xcursor *src =
+		wlr_xcursor_manager_get_xcursor(seat->shake.source, name, 1);
+	if (!base || !src || !base->image_count || !src->image_count) {
+		return;
+	}
+	struct wlr_xcursor_image *base_img = base->images[0];
+	struct wlr_xcursor_image *src_img = src->images[0];
+
+	int out_w = lroundf(base_img->width * seat->shake.scale);
+	int out_h = lroundf(base_img->height * seat->shake.scale);
+	if (out_w < 1 || out_h < 1 || !src_img->width || !src_img->height) {
+		return;
+	}
+	if (seat->shake.applied_name == name
+			&& seat->shake.applied_width == out_w
+			&& seat->shake.applied_height == out_h) {
+		/* Nothing changed, avoid redrawing the same image */
+		return;
+	}
+
+	double fx = (double)out_w / src_img->width;
+	double fy = (double)out_h / src_img->height;
+
+	struct lab_data_buffer *buffer = buffer_create_cairo(out_w, out_h, 1.0);
+	cairo_t *cairo = cairo_create(buffer->surface);
+	/* xcursor images are premultiplied ARGB32, same as cairo */
+	cairo_surface_t *image = cairo_image_surface_create_for_data(
+		src_img->buffer, CAIRO_FORMAT_ARGB32,
+		src_img->width, src_img->height, src_img->width * 4);
+	cairo_scale(cairo, fx, fy);
+	cairo_set_source_surface(cairo, image, 0, 0);
+	cairo_pattern_set_filter(cairo_get_source(cairo), CAIRO_FILTER_BEST);
+	cairo_pattern_set_extend(cairo_get_source(cairo), CAIRO_EXTEND_PAD);
+	cairo_set_operator(cairo, CAIRO_OPERATOR_SOURCE);
+	cairo_paint(cairo);
+	cairo_surface_flush(buffer->surface);
+	cairo_surface_destroy(image);
+	cairo_destroy(cairo);
+
+	wlr_cursor_set_buffer(seat->cursor, &buffer->base,
+		lroundf(src_img->hotspot_x * fx),
+		lroundf(src_img->hotspot_y * fy), 1.0f);
+	/* The cursor keeps its own reference to the buffer */
+	wlr_buffer_drop(&buffer->base);
+
+	seat->shake.applied_name = name;
+	seat->shake.applied_width = out_w;
+	seat->shake.applied_height = out_h;
+}
+
+/*
+ * To be called after the server or a client changed the cursor image, so
+ * that an ongoing enlargement is not lost.
+ */
+static void
+shake_refresh(struct seat *seat)
+{
+	if (seat->shake.scale > 1.0f) {
+		/* The image was replaced behind our back */
+		seat->shake.applied_name = NULL;
+		shake_apply(seat);
+	}
+}
+
+static void
+shake_reset(struct seat *seat)
+{
+	if (seat->shake.source) {
+		wlr_xcursor_manager_destroy(seat->shake.source);
+		seat->shake.source = NULL;
+	}
+	seat->shake.scale = 1.0f;
+	seat->shake.applied_name = NULL;
+	seat->shake.ticking = false;
+	cursor_shake_reset(&seat->shake.detector);
+	if (seat->shake.timer) {
+		/* Disarm the timer */
+		wl_event_source_timer_update(seat->shake.timer, 0);
+	}
+}
+
+/* Load the theme used as the source of the enlarged cursor images */
+static void
+shake_load_source(struct seat *seat)
+{
+	if (!rc.cursor_shake_enabled) {
+		return;
+	}
+	/* Asking for a big size makes the theme pick its biggest bitmaps */
+	seat->shake.source = wlr_xcursor_manager_create(getenv("XCURSOR_THEME"),
+		(uint32_t)lroundf(seat->cursor_size * shake_max_scale()));
+	if (seat->shake.source) {
+		wlr_xcursor_manager_load(seat->shake.source, 1);
+	}
+}
+
+static int
+handle_shake_timer(void *data)
+{
+	struct seat *seat = data;
+	int64_t now = shake_now_msec();
+	int64_t dt = MAX(1, MIN(now - seat->shake.last_tick_msec, 50));
+	seat->shake.last_tick_msec = now;
+
+	float max_scale = shake_max_scale();
+	float span = max_scale - 1.0f;
+	bool shaking = now - seat->shake.last_detect_msec < SHAKE_HOLD_MSEC;
+
+	if (shaking) {
+		seat->shake.scale += span * dt / SHAKE_GROW_MSEC;
+	} else {
+		seat->shake.scale -= span * dt / SHAKE_SHRINK_MSEC;
+	}
+	seat->shake.scale = fmaxf(1.0f, fminf(seat->shake.scale, max_scale));
+
+	shake_apply(seat);
+
+	if (shaking || seat->shake.scale > 1.0f) {
+		wl_event_source_timer_update(seat->shake.timer,
+			SHAKE_TICK_MSEC);
+	} else {
+		seat->shake.ticking = false;
+	}
+	return 0;
+}
+
+static void
+shake_update(struct seat *seat, uint32_t time_msec)
+{
+	if (!rc.cursor_shake_enabled || !seat->shake.timer
+			|| !seat->shake.source) {
+		return;
+	}
+	if (!cursor_shake_feed(&seat->shake.detector, seat->cursor->x,
+			seat->cursor->y, time_msec)) {
+		return;
+	}
+
+	int64_t now = shake_now_msec();
+	seat->shake.last_detect_msec = now;
+	if (!seat->shake.ticking) {
+		seat->shake.ticking = true;
+		seat->shake.last_tick_msec = now;
+		wl_event_source_timer_update(seat->shake.timer,
+			SHAKE_TICK_MSEC);
+	}
+}
+
