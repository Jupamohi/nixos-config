new file mode 100644
index 0000000..6ecc735
--- /dev/null
+++ b/include/input/cursor-shake.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef LABWC_CURSOR_SHAKE_H
+#define LABWC_CURSOR_SHAKE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/*
+ * Detects a "shake" of the pointer: quick back-and-forth movement.
+ *
+ * This file intentionally does not depend on wlroots or the rest of
+ * labwc so that the detection logic can be tested on its own.
+ */
+
+#define CURSOR_SHAKE_MAX_SAMPLES 256
+
+struct cursor_shake_sample {
+	double x, y;
+	uint32_t time_msec;
+};
+
+struct cursor_shake {
+	struct cursor_shake_sample samples[CURSOR_SHAKE_MAX_SAMPLES];
+	int head;  /* index of the oldest sample */
+	int count;
+};
+
+/** Forget all recorded movement */
+void cursor_shake_reset(struct cursor_shake *shake);
+
+/**
+ * Feed the detector with the new pointer position (layout coordinates).
+ *
+ * Returns true while the recent movement looks like a shake, that is: at
+ * least a few direction reversals within a short time frame, covering a
+ * minimum distance on screen.
+ */
+bool cursor_shake_feed(struct cursor_shake *shake, double x, double y,
+	uint32_t time_msec);
+
+#endif /* LABWC_CURSOR_SHAKE_H */
