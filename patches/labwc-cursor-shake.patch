diff --git a/src/input/cursor-shake.c b/src/input/cursor-shake.c
new file mode 100644
index 0000000..5112515
--- /dev/null
+++ b/src/input/cursor-shake.c
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "input/cursor-shake.h"
+#include <math.h>
+
+/* Only movement within this time frame is considered */
+#define SHAKE_WINDOW_MSEC 600
+/* A new sample is recorded only after moving at least this far (px) */
+#define SHAKE_MIN_STEP 6.0
+/* The movement must span at least this distance (px) to count */
+#define SHAKE_MIN_EXTENT 60.0
+/* Direction reversals needed within the window (L-R-L-R is 3) */
+#define SHAKE_MIN_REVERSALS 3
+
+void
+cursor_shake_reset(struct cursor_shake *shake)
+{
+	shake->head = 0;
+	shake->count = 0;
+}
+
+static struct cursor_shake_sample *
+sample_at(struct cursor_shake *shake, int i)
+{
+	return &shake->samples[(shake->head + i) % CURSOR_SHAKE_MAX_SAMPLES];
+}
+
+static void
+drop_oldest(struct cursor_shake *shake)
+{
+	shake->head = (shake->head + 1) % CURSOR_SHAKE_MAX_SAMPLES;
+	shake->count--;
+}
+
+bool
+cursor_shake_feed(struct cursor_shake *shake, double x, double y,
+		uint32_t time_msec)
+{
+	/* Forget samples that are too old (unsigned math survives wrap) */
+	while (shake->count > 0 && (uint32_t)(time_msec
+			- sample_at(shake, 0)->time_msec) > SHAKE_WINDOW_MSEC) {
+		drop_oldest(shake);
+	}
+
+	if (shake->count > 0) {
+		struct cursor_shake_sample *last =
+			sample_at(shake, shake->count - 1);
+		if (hypot(x - last->x, y - last->y) < SHAKE_MIN_STEP) {
+			/* Too small to matter (jitter), keep state as-is */
+			goto evaluate;
+		}
+	}
+
+	if (shake->count == CURSOR_SHAKE_MAX_SAMPLES) {
+		drop_oldest(shake);
+	}
+	struct cursor_shake_sample *s = sample_at(shake, shake->count);
+	s->x = x;
+	s->y = y;
+	s->time_msec = time_msec;
+	shake->count++;
+
+evaluate:
+	if (shake->count < SHAKE_MIN_REVERSALS + 2) {
+		return false;
+	}
+
+	double min_x = sample_at(shake, 0)->x, max_x = min_x;
+	double min_y = sample_at(shake, 0)->y, max_y = min_y;
+	int reversals = 0;
+
+	for (int i = 1; i < shake->count; i++) {
+		struct cursor_shake_sample *a = sample_at(shake, i - 1);
+		struct cursor_shake_sample *b = sample_at(shake, i);
+		min_x = fmin(min_x, b->x);
+		max_x = fmax(max_x, b->x);
+		min_y = fmin(min_y, b->y);
+		max_y = fmax(max_y, b->y);
+
+		if (i >= 2) {
+			struct cursor_shake_sample *p = sample_at(shake, i - 2);
+			double v1x = a->x - p->x, v1y = a->y - p->y;
+			double v2x = b->x - a->x, v2y = b->y - a->y;
+			if (v1x * v2x + v1y * v2y < 0) {
+				reversals++;
+			}
+		}
+	}
+
+	double extent = hypot(max_x - min_x, max_y - min_y);
+	return extent >= SHAKE_MIN_EXTENT && reversals >= SHAKE_MIN_REVERSALS;
+}
